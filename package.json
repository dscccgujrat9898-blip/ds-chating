{
  "name": "ds-chating",
  "version": "1.0.0",
  "description": "Desktop-first WhatsApp-like MVP chat and calling app",
  "main": "electron/main.js",
  "scripts": {
    "start": "concurrently \"node server.js\" \"wait-on tcp:3000 && electron .\"",
    "dev": "concurrently \"node server.js\" \"wait-on tcp:3000 && electron .\"",
    "build:win": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.dschating.app",
    "productName": "DS Chating",
    "files": [
      "electron/**/*",
      "src/**/*",
      "server.js",
      "package.json"
    ],
    "win": {
      "target": "portable"
    }
  },
  "dependencies": {
    "concurrently": "^9.1.2",
    "express": "^4.21.2",
    "ws": "^8.18.3",
    "wait-on": "^8.0.1"
  },
  "devDependencies": {
    "electron": "^35.2.1",
    "electron-builder": "^25.1.8"
  }
}
